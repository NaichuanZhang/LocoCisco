{
  "id": "res_06_is_porch_light_on",
  "title": "\"Is the porch light on?\"",
  "blurb": "A question about device state, not a request (designed): nothing. The keyword baseline hears 'light on'. At-risk: the 12B's only speech failures in the eval were state questions read as requests; here it answered 'not a request' at just 75% (2026-10-20).",
  "tags": [
    "research",
    "speech",
    "state-question",
    "keyword-wrong",
    "at-risk",
    "eval:sp78-type"
  ],
  "steps": [
    {
      "do": "set_time",
      "time": "21:00",
      "weekday": "Tuesday"
    },
    {
      "do": "set_env",
      "room": "living",
      "lux": 150
    },
    {
      "do": "say",
      "who": "alex",
      "text": "Is the porch light on?",
      "lang": "en"
    },
    {
      "do": "expect",
      "what": "proposal",
      "by": "keyword",
      "action": "lights_on",
      "within": 5
    },
    {
      "do": "expect",
      "what": "verdict",
      "verdict": "ignore",
      "within": 15
    },
    {
      "do": "expect",
      "what": "no_command",
      "device": "any",
      "within": 6
    }
  ]
}

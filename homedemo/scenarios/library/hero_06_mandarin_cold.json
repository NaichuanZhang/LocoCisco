{
  "id": "hero_mandarin_cold",
  "title": "“好冷啊” (so cold)",
  "blurb": "Alex complains in Mandarin that the bedroom is cold. The decider raises the heat; the keyword baseline hears nothing.",
  "tags": [
    "hero",
    "speech",
    "mandarin",
    "keyword-misses"
  ],
  "steps": [
    {
      "do": "note",
      "text": "Alex, who grew up speaking Mandarin, goes to bed in a cold room.",
      "wait": 4
    },
    {
      "do": "set_time",
      "time": "22:30",
      "weekday": "Tuesday"
    },
    {
      "do": "set_env",
      "room": "bedroom_main",
      "lux": 120,
      "celsius": 16
    },
    {
      "do": "move",
      "who": "alex",
      "to": "bedroom_main"
    },
    {
      "do": "say",
      "who": "alex",
      "text": "好冷啊。",
      "lang": "zh"
    },
    {
      "do": "expect",
      "what": "proposal",
      "by": "keyword",
      "action": "none",
      "within": 5
    },
    {
      "do": "expect",
      "what": "outcome",
      "action": "warmer",
      "accept": [
        "done",
        "asked"
      ],
      "within": 15
    },
    {
      "do": "note",
      "text": "No English, no command verb, no wake word. The decider still read 好冷啊 ('so cold') as a request for heat (2B 37%, 12B 82%).",
      "wait": 6
    },
    {
      "do": "reply",
      "answer": "Yes",
      "if_asked": true
    },
    {
      "do": "expect",
      "what": "outcome",
      "action": "warmer",
      "accept": [
        "done"
      ],
      "within": 6
    },
    {
      "do": "note",
      "text": "The thermostat went up 1.5 °C. The keyword baseline, which only knows 开灯 and 关灯, heard nothing.",
      "wait": 5
    }
  ]
}
